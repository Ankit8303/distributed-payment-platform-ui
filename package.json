{
  "name": "distributed-payment-platform-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:env": "powershell -ExecutionPolicy Bypass -File ./scripts/verification/verify-env.ps1",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "performance:runtime": "node ./scripts/performance/runtime-benchmark.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "postcss": "$postcss",
    "vite": "6.4.3"
  }
}
