# Distributed Payment Platform UI - Public Environment Configuration Contract
# INVARIANT: Only browser-safe variables with the NEXT_PUBLIC_ prefix are permitted.
# DO NOT commit secrets, private keys, database credentials, or API keys here.

# [REQUIRED IN PRODUCTION] Authoritative Spring Boot backend API URL.
# In production, this MUST:
# 1. Be an absolute URL using HTTPS
# 2. Not target localhost, 127.0.0.1, or 0.0.0.0
# 3. Not contain embedded user credentials or URL fragments
# Example: NEXT_PUBLIC_API_URL=https://api.paymentplatform.com
# Local development only: if unset, falls back to http://localhost:8080.
NEXT_PUBLIC_API_URL=
